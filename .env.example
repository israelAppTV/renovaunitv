# URL do projeto Supabase (pode ser pública)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave service_role — apenas servidor (Vercel / .env.local). Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Segmento secreto da URL do painel: acesso só em https://seu-dominio/ESSE_VALOR
# Use string longa e aleatória (ex.: openssl rand -hex 24)
ADMIN_PANEL_SECRET=

# Hash bcrypt da senha admin (custo >= 12). Gerar no Node:
# node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_FORTE', 12))"
ADMIN_PASSWORD_BCRYPT_HASH=

# Segredo HMAC para assinar cookie de sessão admin (ex.: openssl rand -base64 32)
ADMIN_SESSION_SECRET=

# URL pública HTTPS do site (obrigatória para callbacks de pagamento).
# O provedor de pagamento NÃO aceita http://localhost — em dev use ngrok (passo a passo: docs/ngrok-checkout.md).
# Terminal 1: npm run dev | Terminal 2: npm run tunnel | copie a URL https e coloque abaixo.
# Na Vercel deixe em branco (usa VERCEL_URL) ou defina o domínio customizado.
# NEXT_PUBLIC_SITE_URL=https://xxxx.ngrok-free.app

# WhatsApp de suporte/comercial (usado no card de ajuda Android e no checkout anual).
# Exemplo: NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=https://wa.me/5562998060804
# NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=

# DePix API key
# - Testes/homologação: sk_test_*
# - Produção: sk_live_*
DEPIX_API_KEY=
# Segredo de assinatura de webhook (Área do Lojista)
DEPIX_WEBHOOK_SECRET=
# Base URL da API DePix (opcional)
# DEPIX_API_BASE_URL=https://depix-backend.vercel.app
# Logs detalhados de homologação (request/response checkout + webhook)
# DEPIX_HOMOLOG_LOGS=true

# E-mail (Resend) — envio do código após o webhook DePix confirmar pagamento
# 1) Verifique um domínio no painel Resend (DNS). onboarding@resend.dev só envia para o e-mail da sua conta Resend.
# 2) Produção (NODE_ENV=production, ex.: Vercel): obrigatório RESEND_FROM com endereço @seu-dominio-verificado
#    Ex.: RESEND_FROM="UniTV <noreply@renovaunitv.com.br>"
# 3) Dev local sem RESEND_FROM: usa onboarding@resend.dev automaticamente.
# 4) Opcional (não recomendado em produção real): RESEND_ALLOW_RESEND_DEV_SENDER=true força remetente de teste.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="UniTV <noreply@renovaunitv.com.br>"
